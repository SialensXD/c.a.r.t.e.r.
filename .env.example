# Telegram BotFather token. Get it from @BotFather
BOT_TOKEN=replace-me

# Groq API Configuration - Get free API key from https://console.groq.com/
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.1-8b-instant
# Alternative free models: llama-3.3-70b-versatile, qwen/qwen3-32b

# Owner name for AI context
OWNER_NAME=Сияленс

# Optional: PostgreSQL connection string for conversation history
# Leave empty if you don't need database functionality
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Render provides this automatically for a web service when configured.
RENDER_EXTERNAL_URL=https://your-service.onrender.com
PORT=10000
WEBHOOK_SECRET=generate-a-random-secret

# Owner (main admin) user ID - for admin commands
OWNER_USER_ID=7857165309
